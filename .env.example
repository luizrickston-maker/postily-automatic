# ===== Server =====
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
PUBLIC_URL=http://localhost:3000

# ===== Database (Supabase POSTLY — projeto separado do taskvision) =====
# Pegue em: Supabase Dashboard → Project Settings → Database → Connection string (URI mode)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# ===== Supabase Storage (projeto POSTLY — para upload de mídia) =====
SUPABASE_URL=https://[postly-project-ref].supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOi...   # service_role key (NÃO a anon key)
SUPABASE_STORAGE_BUCKET=postly-media   # crie o bucket privado no dashboard

# ===== Meta / Instagram / Facebook =====
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/oauth/instagram/callback
META_GRAPH_VERSION=v20.0

# ===== TikTok =====
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/oauth/tiktok/callback

# ===== LinkedIn =====
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/oauth/linkedin/callback

# ===== Scheduler =====
SCHEDULER_POLL_MS=30000
SCHEDULER_BATCH_SIZE=10
SCHEDULER_ENABLED=true

# ===== Auth =====
API_KEY_SECRET=change-me-in-production-min-32-chars